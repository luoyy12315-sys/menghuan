<?xml version="1.0" encoding="utf-8"?>
<!--
    网络安全策略（v0.35.2 起）

    为什么全局放开明文 HTTP：用户在「设置 · API 配置」里可自定义任意第三方 OpenAI 兼容端点，
    无法枚举域名白名单。填 http:// 时 Android 9+ 默认拒绝（CLEARTEXT ... not permitted），
    这里显式放行。风险由用户自己承担（他填的地址他自己知道）。

    证书信任锚：
    - system：系统 CA（默认），能拦住自签/伪造证书
    - user：允许用户手动安装到设备的 CA。遇到自签服务商时，把 CA 装进设备即可，
      不需要在代码里信任所有证书（那种做法会让任何中间人都能截走 API Key）。

    HostnameVerifier 的宽松策略在 llm/NetworkStack.kt 里，
    仅跳过"域名 vs 证书 CN/SAN"匹配，证书链本身仍走系统 TrustManager 校验。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
