<?xml version="1.0" encoding="utf-8"?>
<!--
  API 29+：退出系统 Force Dark。
  v0.35.0 起 App 自带深色主题（设置 · 外观：跟随系统 / 浅色 / 深色），
  深浅由 LocalNeuPalette 自己控制；但系统的 Force Dark 是**另一套**强制反色机制，
  它会把我们的发丝线与纸叠阴影搅成无法辨认的色块（真机"全是乱码/UI 错乱"的主因）。
  系统栏图标的明暗在 Compose 侧按当前主题动态切换（MainActivity.MenghuanThemedRoot），
  这里只锁默认浅色取值，深色由 values-night 覆盖。
-->
<resources>
    <style name="Theme.Menghuan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/neu_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>